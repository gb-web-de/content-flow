            <!--
                Every message below is shown to an editor who cannot read the
                code, so each carries a code of its own: it is what a bug report
                can name and what a support answer can be looked up by. The code
                is part of the translated text so it survives translation.
            -->
            <trans-unit id="wizard.error.invalidSubmission" xml:space="preserve">
                <source>This wizard was opened with data that cannot be read. Close it and start again. (CF-1001)</source>
            </trans-unit>
            <trans-unit id="wizard.error.unknownMode" xml:space="preserve">
                <source>This wizard does not know what it was asked to do. Close it and start again. (CF-1002)</source>
            </trans-unit>
            <trans-unit id="wizard.error.titleRequiredToKeep" xml:space="preserve">
                <source>A title is required to keep this task. (CF-1003)</source>
            </trans-unit>
