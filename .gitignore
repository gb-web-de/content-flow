.Build/
.cache/
.php-cs-fixer.cache
var/

# Generated instance state. Despite "app-dir": ".Build" in composer.json, TYPO3
# writes config/ and var/ to the project root - config/system/settings.php holds
# the instance encryptionKey and must never be committed.
config/
Tests/Functional/*/typo3temp/
.ddev/db_snapshots/
.ddev/.dbimageBuild/
.ddev/.webimageBuild/
.ddev/.sshimageBuild/
.idea/
.DS_Store

# Playwright dev tooling (package.json/playwright.config.ts are the only
# parts of this that get committed).
node_modules/
playwright-report/
test-results/
