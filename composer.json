{
    "name": "gb-web/content-flow",
    "type": "typo3-cms-extension",
    "description": "Content Flow - Editorial Kanban board that unifies xima/xima-typo3-content-planner statuses with TYPO3 workspace stages.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Gordon Brueggemann",
            "email": "gordon.brueggemann@gb-web.de",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/gb-web/content-flow/issues",
        "source": "https://github.com/gb-web/content-flow"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "typo3/cms-backend": "~14.3.0@dev",
        "typo3/cms-core": "~14.3.0@dev",
        "typo3/cms-dashboard": "~14.3.0@dev",
        "typo3/cms-extbase": "~14.3.0@dev",
        "typo3/cms-fluid": "~14.3.0@dev",
        "typo3/cms-workspaces": "~14.3.0@dev",
        "xima/xima-typo3-content-planner": "^2.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.1",
        "phpstan/phpstan": "^2.1.54",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpunit/phpunit": "^11.5.55",
        "saschaegerer/phpstan-typo3": "^3.0.1",
        "typo3/cms-fluid-styled-content": "~14.3.0@dev",
        "typo3/cms-install": "~14.3.0@dev",
        "typo3/cms-rte-ckeditor": "~14.3.0@dev",
        "typo3/cms-setup": "~14.3.0@dev",
        "typo3/testing-framework": "^9.5",
        "typo3/theme-camino": "~14.3.0@dev"
    },
    "autoload": {
        "psr-4": {
            "GbWeb\\ContentFlow\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GbWeb\\ContentFlow\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "content_flow",
            "web-dir": ".Build/Web",
            "app-dir": ".Build"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "optimize-autoloader": true,
        "lock": false,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "typo3:setup": [
            ".Build/bin/typo3 setup --driver=mysqli --host=db --dbname=db --username=db --password=db --admin-username=admin --admin-user-password=AdminPassword123! --admin-email=admin@email.com --project-name='Content Flow' --server-type=other --create-site=https://content-flow.ddev.site/ --force --no-interaction"
        ],
        "typo3:demo-content": [
            ".Build/bin/typo3 extension:setup --extension=theme_camino",
            ".Build/bin/typo3 extension:setup --extension=xima_typo3_content_planner",
            ".Build/bin/typo3 extension:setup --extension=content_flow"
        ],
        "cs:check": "${PHP_BINARY} .Build/bin/php-cs-fixer fix --config Build/php-cs-fixer/php-cs-rules.php --diff --dry-run",
        "cs:fix": "${PHP_BINARY} .Build/bin/php-cs-fixer fix --config Build/php-cs-fixer/php-cs-rules.php",
        "phpstan": "${PHP_BINARY} .Build/bin/phpstan analyse -c Build/phpstan/phpstan.neon --no-progress",
        "test:unit": "${PHP_BINARY} .Build/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "${PHP_BINARY} .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml"
    }
}
